# -- events

@events.on_ptk_create
def custom_keybindings(bindings, **kw):
    @bindings.add(Keys.F12)
    def restart_device(event):
        def _run():
            subprocess.run(
                shlex.split("pymobiledevice3 diagnostics restart"),
                check=False,
            )
            print("\nRestarting device", flush=True)

        # Give the terminal to the subprocess (fixes Enter / stdin issues)
        run_in_terminal(_run)
        event.app.invalidate()


@events.on_transform_command
def expand_braces(cmd, **a):
    if '[' in cmd or '$(' in cmd or '@(' in cmd:
        return cmd

    parts = shlex.split(cmd)
    expanded_cmds = []
    requires_expansion = False

    for part in parts:
        if "{" in part and "}" in part:
            prefix, braces, postfix = part.partition("{")
            options, _, postfix = postfix.partition("}")
            expanded_parts = [
                prefix + option + postfix for option in options.split(",")
            ]
            expanded_cmds.extend(expanded_parts)
            requires_expansion = True
        else:
            expanded_cmds.append(part)

    if requires_expansion:
        return " ".join(expanded_cmds)

    return cmd


@events.on_chdir
def handler_chdir(olddir, newdir, **kw):
    """
    Event handler that updates the prompt when the directory changes
    """
    print(f'\033]9;9;{newdir}\033\\\033[A', end='')


# -- alias

@unthreadable
def _ggpush(args) -> None:
    XSH.builtins.execx(f'git push origin {XSH.env["PROMPT_FIELDS"]["curr_branch"]()} {shlex.join(args)}')


def _rcpull(args) -> None:
    parser = ArgumentParser(description='pull latest .xonshrc')
    args = parser.parse_args(args)

    XSH.builtins.execx("cd $WORKSETUP_ROOT/worksetup")
    XSH.builtins.execx("ggpull")
    XSH.builtins.execx("cp .xonshrc ~/")
    XSH.builtins.execx("cd -")
    XSH.builtins.execx("reload")


def _rcpush(args) -> None:
    parser = ArgumentParser(description='push latest .xonshrc')
    args = parser.parse_args(args)

    XSH.builtins.execx("cd $WORKSETUP_ROOT/worksetup")
    XSH.builtins.execx("cp ~/.xonshrc .")
    XSH.builtins.execx("ga .xonshrc")
    XSH.builtins.execx("git commit -m 'update .xonshrc'")
    XSH.builtins.execx("ggpush")
    XSH.builtins.execx("cd -")


def _plshow(filename: str, uncolored=False):
    """
    display a plist file

    Parameters
    ----------
    uncolored : -u, --uncolored
        remove colors
    """
    with open(filename, 'rb') as f:
        return _pretty_json(plistlib.load(f), colored=(not uncolored))


def _subprocess(args: list[str]) -> None:
    subprocess.Popen(args, shell=True)


def _pycharm(args) -> None:
    if 1 != os.system('where pycharm.rc >nul 2>&1'):
        _subprocess(['pycharm.rc', *args])
    elif 1 != os.system('where pycharm >nul 2>&1'):
        _subprocess(['pycharm', *args])


def _clion(args) -> None:
    if 1 != os.system('where clion >nul 2>&1'):
        _subprocess(['clion', *args])


def _webstorm(args) -> None:
    if 1 != os.system('where webstorm >nul 2>&1'):
        _subprocess(['webstorm', *args])


def _datagrip(args):
    if 1 != os.system('where datagrip >nul 2>&1'):
        _subprocess(['datagrip', *args])


def _tarsplit(dirname: str):
    """
    archives given directory and splits into out
    """
    dirname = Path(dirname)

    if not dirname.is_dir():
        print(f'{dirname} is not a directory')
        return 1

    tarfile = f'{dirname}.tar'

    local['tar']['-cvf', tarfile, dirname] & FG
    prefix = f'{dirname}_part_'
    local['split']['-b', '3G', str(tarfile), str(prefix)] & FG


def _open_github(args):
    try:
        import webbrowser
        from pathlib import Path

        # Ensure we're inside a Git repo
        root = subprocess.check_output(['git', 'rev-parse', '--show-toplevel'], text=True).strip()
        os.chdir(root)

        # Get current remote URL
        remote_url = subprocess.check_output(['git', 'remote', 'get-url', 'origin'], text=True).strip()

        # Get current branch name
        branch = subprocess.check_output(['git', 'rev-parse', '--abbrev-ref', 'HEAD'], text=True).strip()

        # Parse remote URL
        if remote_url.startswith('git@'):
            # git@github.com:user/repo.git
            _, path = remote_url.split(':', 1)
            url = f'https://github.com/{path}'
        elif remote_url.startswith('https://') or remote_url.startswith('http://'):
            url = remote_url
        else:
            print(f"Unsupported remote URL: {remote_url}")
            return

        url = url.rstrip('.git')
        url += f'/tree/{branch}'
        webbrowser.open(url)
    except subprocess.CalledProcessError:
        print('Not a git repository or no remote "origin" set.')
    except Exception as e:
        print(f'Error: {e}')


def _tab_color_completer(xsh, action, completer, alias, command):
    return TAB_COLORS.keys()


def _tab_color(color: Annotated[str, Arg(completer=_tab_color_completer)]) -> None:
    "Change current tab color"
    if color not in TAB_COLORS:
        print(f"Not a valid color. Must be one of: {TAB_COLORS.keys()}")
        return
    subprocess.Popen(['wt', '--tabColor', TAB_COLORS[color]])


def _pull_history(args) -> None:
    cnt = XSH.history.pull(show_commands=False)
    print(f'Pulled {cnt} new commands from other sessions.')


